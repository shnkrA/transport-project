# ==========================================
# Серверна частина (NestJS Backend)
# ==========================================
NODE_ENV=development
PORT=3000

# PostgreSQL
DB_TYPE=postgres
DB_HOST=db
DB_PORT=5432
DB_NAME=transport_db
DB_USER=transport_user
DB_PASSWORD=transport_password
DB_SYNC=true

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# БПФК (для майбутньої інтеграції)
FISCAL Printer_API_URL=
FISCAL Printer_API_KEY=

# GPS-трекер (для майбутньої інтеграції)
GPS_API_URL=
GPS_API_KEY=

# Логінг
LOG_LEVEL=debug

# ==========================================
# Клієнтська частина (React Frontend)
# ==========================================
REACT_APP_API_URL=http://localhost:3000
REACT_APP_NAME=Транспортне підприємство
